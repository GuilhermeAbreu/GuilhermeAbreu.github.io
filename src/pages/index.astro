---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Tags from "../components/Tags.astro";
import {
  profile,
  about,
  highlights,
  projects,
  caseStudies,
  experience,
  education,
  skills,
  testimonial,
} from "../data/profile";

const nav = [
  { href: "#sobre", label: "Sobre" },
  { href: "#projetos", label: "Projetos" },
  { href: "#casos", label: "Casos" },
  { href: "#experiencia", label: "Experiência" },
  { href: "#contato", label: "Contato" },
];

const socials = [
  { href: profile.links.github, label: "GitHub" },
  { href: profile.links.linkedin, label: "LinkedIn" },
  { href: profile.links.npm, label: "npm" },
  { href: profile.links.youtube, label: "YouTube" },
].filter((s) => s.href);

// "2 mil+" vira { count: 2, suffix: " mil+" } para o contador animar só o número
const stats = highlights.map((h) => {
  const [, count = "", suffix = h.value] = h.value.match(/^(\d+)(.*)$/) ?? [];
  return { ...h, count, suffix };
});

const delay = (i: number, step = 90) => `--delay: ${i * step}ms`;

const card =
  "rounded-2xl border border-[var(--border)] bg-[var(--surface)] transition duration-300 hover:-translate-y-1 hover:border-[var(--accent)] hover:shadow-[0_12px_40px_-12px_var(--accent-soft)]";
const link = "underline decoration-[var(--accent)] decoration-2 underline-offset-4 hover:text-[var(--accent)]";
---

<Base>
  <header class="sticky top-0 z-10 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
      <a href="#" class="font-bold tracking-tight">guilherme<span class="text-[var(--accent)]">.dev</span></a>
      <nav aria-label="Seções" class="flex items-center gap-1">
        <ul class="hidden gap-1 text-sm text-[var(--muted)] md:flex">
          {nav.map((n) => (
            <li><a href={n.href} class="rounded-md px-3 py-1.5 transition-colors hover:text-[var(--text)]">{n.label}</a></li>
          ))}
        </ul>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Alternar tema claro/escuro"
          class="ml-2 grid size-9 place-items-center rounded-md border border-[var(--border)] transition hover:rotate-12 hover:border-[var(--accent)]"
        >
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-5xl overflow-x-clip px-4 sm:px-6">
    <!-- Hero -->
    <section class="relative flex flex-col-reverse items-start gap-10 py-16 sm:py-24 md:flex-row md:items-center">
      <div
        class="hero-glow pointer-events-none absolute top-0 -right-10 -z-10 size-[32rem] bg-[radial-gradient(circle,var(--accent)_0%,transparent_65%)] opacity-30"
        aria-hidden="true"
      />
      <div class="flex-1">
        <p data-reveal style={delay(0)} class="font-mono text-sm text-[var(--accent)]">Oi, eu sou o</p>
        <h1 data-reveal style={delay(1)} class="mt-2 text-4xl font-extrabold tracking-tight sm:text-6xl">{profile.name}</h1>
        <p data-reveal style={delay(2)} class="mt-2 text-xl font-semibold text-[var(--muted)] sm:text-2xl">{profile.role}</p>
        <p data-reveal style={delay(3)} class="mt-6 max-w-xl text-lg leading-relaxed">{profile.tagline}</p>
        <p data-reveal style={delay(4)} class="mt-3 text-sm text-[var(--muted)]">📍 {profile.location}</p>
        <div data-reveal style={delay(5)} class="mt-8 flex flex-wrap gap-3">
          <a href="#contato" class="rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-110 dark:text-[#0c0a14]">Fale comigo</a>
          {profile.cv && (
            <a href={profile.cv} download class="rounded-lg border border-[var(--border)] px-5 py-2.5 font-semibold transition hover:-translate-y-0.5 hover:border-[var(--accent)]">Baixar CV</a>
          )}
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" class="rounded-lg border border-[var(--border)] px-4 py-2.5 font-medium transition hover:-translate-y-0.5 hover:border-[var(--accent)]">{s.label}</a>
          ))}
        </div>
      </div>
      <div data-reveal style={delay(2)}>
        <img
          src={profile.avatar}
          alt={`Foto de ${profile.name}`}
          width="176"
          height="176"
          class="avatar-float size-32 rounded-full border-4 border-[var(--accent-soft)] object-cover sm:size-44"
        />
      </div>
    </section>

    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {stats.map((s, i) => (
        <li data-reveal style={delay(i)} class={`${card} p-5`}>
          <p class="text-3xl font-extrabold text-[var(--accent)]">
            <span data-count={s.count}>{s.count}</span>{s.suffix}
          </p>
          <p class="mt-1 text-sm text-[var(--muted)]">{s.label}</p>
        </li>
      ))}
    </ul>

    <Section id="sobre" eyebrow="01. sobre" title="Do PHP ao app que roda sem sinal">
      <div class="grid gap-10 md:grid-cols-[3fr_2fr]">
        <div class="space-y-4 leading-relaxed text-[var(--muted)]">
          {about.map((p, i) => <p data-reveal style={delay(i)}>{p}</p>)}
        </div>
        <ul class="space-y-5">
          {skills.map((s, i) => (
            <li data-reveal style={delay(i)}>
              <p class="mb-2 text-sm font-semibold">{s.group}</p>
              <Tags items={s.items} />
            </li>
          ))}
        </ul>
      </div>
    </Section>

    <Section
      id="projetos"
      eyebrow="02. open source"
      title="Projetos"
      intro="Quase todos nasceram de um problema que eu mesmo tive."
    >
      <ul class="grid gap-4 sm:grid-cols-2">
        {projects.map((p, i) => (
          <li data-reveal style={delay(i % 2)} class={`${card} flex flex-col p-6`}>
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-mono font-semibold">{p.name}</h3>
              {p.badge && <span class="shrink-0 rounded-full bg-[var(--accent-soft)] px-2.5 py-0.5 text-xs font-medium text-[var(--accent)]">{p.badge}</span>}
            </div>
            <p class="mt-3 flex-1 leading-relaxed text-[var(--muted)]">{p.description}</p>
            <div class="mt-5"><Tags items={p.stack} /></div>
            {(p.repo || p.npm) && (
              <div class="mt-4 flex gap-4 text-sm font-medium">
                {p.repo && <a href={p.repo} target="_blank" rel="noopener" class={link}>Código</a>}
                {p.npm && <a href={p.npm} target="_blank" rel="noopener" class={link}>npm</a>}
              </div>
            )}
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="casos"
      eyebrow="03. no trabalho"
      title="Problemas que resolvi"
      intro="Alguns perrengues do dia a dia e como saí deles. Sem código e sem dado de cliente, claro."
    >
      <ul class="grid gap-4 md:grid-cols-2">
        {caseStudies.map((c, i) => (
          <li data-reveal style={delay(i % 2)} class={`${card} p-6`}>
            <h3 class="text-lg font-semibold">{c.title}</h3>
            <p class="mt-3 leading-relaxed text-[var(--muted)]">{c.text}</p>
            <div class="mt-5"><Tags items={c.stack} /></div>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="experiencia" eyebrow="04. trajetória" title="Por onde passei">
      <ol class="relative space-y-8 border-l-2 border-[var(--border)] pl-6 sm:pl-8">
        {experience.map((job, i) => (
          <li data-reveal class="relative">
            <span
              class:list={[
                "absolute top-1.5 -left-[31px] size-3 rounded-full border-2 border-[var(--accent)] sm:-left-[39px]",
                i === 0 ? "animate-pulse bg-[var(--accent)]" : "bg-[var(--bg)]",
              ]}
              aria-hidden="true"
            />
            <p class="font-mono text-xs text-[var(--muted)]">{job.period} · {job.place}</p>
            <h3 class="mt-1 font-semibold">{job.role}</h3>
            <p class="text-[var(--accent)]">{job.company}</p>
            <p class="mt-2 max-w-2xl leading-relaxed text-[var(--muted)]">{job.summary}</p>
            <div class="mt-3"><Tags items={job.stack} /></div>
          </li>
        ))}
      </ol>

      <div data-reveal class={`${card} mt-12 p-6`}>
        <p class="font-mono text-xs text-[var(--muted)]">Formação · {education.period}</p>
        <h3 class="mt-1 font-semibold">{education.course}</h3>
        <p class="text-[var(--accent)]">{education.school}</p>
      </div>
    </Section>

    <figure data-reveal class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 sm:p-10">
      <p class="font-mono text-sm text-[var(--accent)]">o que dizem por aí</p>
      <blockquote class="mt-4 text-lg leading-relaxed sm:text-xl">“{testimonial.quote}”</blockquote>
      <figcaption class="mt-5 text-sm">
        <span class="font-semibold">{testimonial.author}</span>
        <span class="text-[var(--muted)]"> · {testimonial.role} · recomendação no LinkedIn</span>
      </figcaption>
    </figure>

    <Section id="contato" eyebrow="05. contato" title="Bora conversar?">
      <p data-reveal class="max-w-xl text-lg leading-relaxed text-[var(--muted)]">
        Estou aberto a novas oportunidades em mobile ou full stack. Se quiser trocar uma ideia, me chama por e-mail ou no LinkedIn.
      </p>
      <div data-reveal style={delay(1)} class="mt-8 flex flex-wrap gap-3">
        <a href={`mailto:${profile.email}`} class="rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-white transition hover:-translate-y-0.5 hover:brightness-110 dark:text-[#0c0a14]">{profile.email}</a>
        <a href={profile.links.linkedin} target="_blank" rel="noopener" class="rounded-lg border border-[var(--border)] px-5 py-2.5 font-semibold transition hover:-translate-y-0.5 hover:border-[var(--accent)]">LinkedIn</a>
      </div>
    </Section>
  </main>

  <footer class="border-t border-[var(--border)] py-8 text-center text-sm text-[var(--muted)]">
    © {new Date().getFullYear()} {profile.name} · feito com Astro e Tailwind
  </footer>

  <script>
    const toggle = document.getElementById("theme-toggle");
    toggle?.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });

    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (reduceMotion || !target) return;
      const duration = 1200;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = "0";
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.classList.add("is-visible");
          el.querySelectorAll<HTMLElement>("[data-count]").forEach(countUp);
          observer.unobserve(el);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
    );

    document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
  </script>
</Base>
