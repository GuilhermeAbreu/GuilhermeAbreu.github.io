---
type Props = { items: string[] };
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologias">
      {items.map((item) => (
        <li class="rounded-md bg-[var(--accent-soft)] px-2 py-0.5 font-mono text-xs text-[var(--accent)]">
          {item}
        </li>
      ))}
    </ul>
  )
}
