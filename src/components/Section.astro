---
type Props = { id: string; eyebrow: string; title: string; intro?: string };
const { id, eyebrow, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-20 py-16 sm:py-20">
  <div data-reveal>
    <p class="font-mono text-sm text-[var(--accent)]">{eyebrow}</p>
    <h2 class="mt-2 text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
    {intro && <p class="mt-3 max-w-2xl text-[var(--muted)]">{intro}</p>}
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
