---
import "../styles/global.css";
import { profile, type Lang } from "../data/profile";

type Props = { lang: Lang };
const { lang } = Astro.props;

const title = `${profile.name} · ${profile.role[lang]}`;
const description = profile.tagline[lang];
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const paths: Record<Lang, string> = { pt: "/", en: "/en/" };
---

<!doctype html>
<html lang={lang === "pt" ? "pt-BR" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`${site}${paths[lang]}`} />
    <link rel="alternate" hreflang="pt-BR" href={`${site}${paths.pt}`} />
    <link rel="alternate" hreflang="en" href={`${site}${paths.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${paths.pt}`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "pt" ? "pt_BR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}${paths[lang]}`} />
    <meta property="og:image" content={profile.avatar} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Aplica o tema antes da pintura para não piscar
      (() => {
        let theme = "dark";
        try {
          theme =
            localStorage.getItem("theme") ??
            (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <slot />
  </body>
</html>
